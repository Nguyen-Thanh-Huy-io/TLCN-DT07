// ================================
// Flashcards — thẻ ghi nhớ & lặp lại ngắt quãng (SM-2)
// Bảng mới độc lập, không sửa đổi các bảng/enum cũ.
// ================================

model FlashcardDeck {
  id          String      @id @default(uuid())
  ownerId     String      @map("owner_id")
  title       String      @db.VarChar(150)
  description String?     @db.VarChar(400)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  cards       Flashcard[]

  @@index([ownerId, updatedAt])
  @@map("flashcard_decks")
}

model Flashcard {
  id             String        @id @default(uuid())
  deckId         String        @map("deck_id")
  ownerId        String        @map("owner_id")
  front          String        @db.Text
  back           String        @db.Text
  sourceNoteId   String?       @map("source_note_id")
  repetitions    Int           @default(0)
  intervalDays   Int           @default(0) @map("interval_days")
  easeFactor     Float         @default(2.5) @map("ease_factor")
  nextReviewAt   DateTime      @default(now()) @map("next_review_at")
  lastReviewedAt DateTime?     @map("last_reviewed_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  deck FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@index([deckId, nextReviewAt])
  @@index([ownerId, nextReviewAt])
  @@map("flashcards")
}
