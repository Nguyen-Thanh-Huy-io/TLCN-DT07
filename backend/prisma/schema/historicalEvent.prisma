// ================================
// Historical Event — bảng con 1-1 của HistoricalEntity (type=EVENT), cùng mẫu với
// Person/HistoricalSite. title/slug/startYear.../description/imageUrl/status đều dùng
// field tương ứng trên HistoricalEntity (name/slug/startYear.../description/imageUrl/
// status) — không lặp lại ở đây. Địa điểm diễn ra chính và media dùng chung cơ chế của
// HistoricalEntity (Statement predicate OCCURRED_AT, HistoricalEntityMedia).
// ================================

model HistoricalEvent {
  entityId      String   @id @map("entity_id")
  parentId      String?  @map("parent_id")
  /// Loại sự kiện theo danh mục dùng chung (nhóm EVENT_TYPE), phần tử đầu là loại chính.
  categoryIds   String[] @default([]) @map("category_ids")
  /// Ghi chú niên đại dạng chữ khi ngày tháng không quy đổi gọn được (vd. "Đợt 1: 30/01-25/02/1968").
  eventDateNote String?  @map("event_date_note") @db.VarChar(150)

  // Relations
  entity   HistoricalEntity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  parent   HistoricalEvent?  @relation("EventHierarchy", fields: [parentId], references: [entityId], onDelete: SetNull)
  children HistoricalEvent[] @relation("EventHierarchy")

  @@index([parentId])
  @@index([categoryIds], type: Gin)
  @@map("historical_events")
}
