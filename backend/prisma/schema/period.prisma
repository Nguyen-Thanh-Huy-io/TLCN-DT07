// ================================
// Period (Historical Period) Model
// ================================

model Period {
  id       String  @id @default(uuid())
  parentId String? @map("parent_id")

  name String @db.VarChar(255)
  slug String @unique @db.VarChar(255)

  // Niên đại có thể không xác định
  startYear     Int?           @map("start_year")
  endYear       Int?           @map("end_year")
  timeLabel     String?        @map("time_label") @db.VarChar(150)
  datePrecision DatePrecision? @map("date_precision")

  // Phạm vi lịch sử
  region        String? @db.VarChar(100)
  /// Khu vực theo danh mục dùng chung (nhóm REGION); cột region chữ giữ song song trong lúc chuyển đổi.
  regionId      String? @map("region_id")
  description   String? @db.Text
  coverImageUrl String? @map("cover_image_url") @db.VarChar(500)

  displayOrder Int           @default(0) @map("display_order")
  status       ContentStatus @default(DRAFT)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  parent     Period?       @relation("PeriodHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   Period[]      @relation("PeriodHierarchy")
  regionTerm TaxonomyTerm? @relation("PeriodRegionTerm", fields: [regionId], references: [id], onDelete: SetNull)

  historicalEntities HistoricalEntity[]
  historicalEvents   HistoricalEvent[]

  @@index([parentId])
  @@index([region])
  @@index([regionId])
  @@index([status])
  @@index([startYear, endYear])
  @@map("periods")
}
