// ================================
// Historical Event Model (Master Data dùng chung + Mạng lưới liên kết Knowledge Graph)
// ================================

model HistoricalEvent {
  id            String        @id @default(uuid())
  periodId      String?       @map("period_id")
  locationId    String?       @map("location_id")
  parentId      String?       @map("parent_id")
  title         String        @db.VarChar(255)
  slug          String        @unique @db.VarChar(255)
  startYear     Int           @map("start_year")
  startMonth    Int?          @map("start_month")
  startDay      Int?          @map("start_day")
  endYear       Int?          @map("end_year")
  endMonth      Int?          @map("end_month")
  endDay        Int?          @map("end_day")
  eventDateNote String?       @map("event_date_note") @db.VarChar(150)
  summary       String?       @db.Text
  description   String?       @db.Text
  thumbnailUrl  String?       @map("thumbnail_url") @db.VarChar(500)
  displayOrder  Int           @default(0) @map("display_order")
  category      EventCategory @default(OTHER)
  metadata      Json?         @db.JsonB
  status        ContentStatus @default(PUBLISHED)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  period   Period?                 @relation(fields: [periodId], references: [id], onDelete: SetNull)
  location HistoricalEntity?       @relation("EventPrimaryLocation", fields: [locationId], references: [id], onDelete: SetNull)
  parent   HistoricalEvent?        @relation("HistoricalEventHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children HistoricalEvent[]       @relation("HistoricalEventHierarchy")
  entities HistoricalEventEntity[]
  media    HistoricalEventMedia[]

  // Quan hệ mạng lưới tri thức & nhân quả (Event Causal Knowledge Graph)
  outgoingRelations HistoricalEventRelation[] @relation("SourceEventRelation")
  incomingRelations HistoricalEventRelation[] @relation("TargetEventRelation")

  @@index([periodId])
  @@index([locationId])
  @@index([parentId])
  @@index([startYear, startMonth, startDay])
  @@index([category])
  @@index([displayOrder])
  @@index([status])
  @@map("historical_events")
}

// Bảng nối nhiều-nhiều: Sự kiện Lịch sử ↔ Thực thể Lịch sử (Nhân vật, Địa điểm, Lực lượng, Hiện vật)
model HistoricalEventEntity {
  eventId  String @map("event_id")
  entityId String @map("entity_id")

  // 1. Mã chuẩn hóa dùng cho Code / Filter / Vẽ cạnh Đồ thị (Chọn từ Dropdown)
  role String @default("PARTICIPANT") @db.VarChar(50)

  // 2. Nhãn hiển thị tiếng Việt cụ thể trong sự kiện này (Không bắt buộc - Gõ tự do trên CMS)
  // VD: "Tổng chỉ huy chiến dịch", "Nơi ký kết hiệp định", "Phe thắng trận"
  roleLabel String? @map("role_label") @db.VarChar(150)

  // 3. Cờ đánh dấu Thực thể/Địa điểm tiêu biểu nhất của sự kiện (Hiện lên Card / Ghim bản đồ chính)
  isPrimary Boolean @default(false) @map("is_primary")

  // 4. Thứ tự sắp xếp hiển thị trên UI (Ai/Địa điểm nào hiện trước)
  displayOrder Int @default(0) @map("display_order")

  // 5. Ghi chú chi tiết thêm về sự tham gia của thực thể trong sự kiện (nếu có)
  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  event  HistoricalEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  entity HistoricalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([eventId, entityId])
  @@index([eventId, isPrimary])
  @@index([entityId])
  @@index([role])
  @@map("historical_event_entities")
}

// Bảng lưu trữ đa phương tiện (ảnh, video, tài liệu) cho Sự kiện Lịch sử
model HistoricalEventMedia {
  id           String    @id @default(uuid())
  eventId      String    @map("event_id")
  type         MediaType @default(IMAGE)
  url          String    @db.VarChar(500)
  caption      String?   @db.VarChar(255)
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")

  // Relations
  event HistoricalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([displayOrder])
  @@map("historical_event_media")
}

// Bảng quan hệ mạng lưới đồ thị tri thức & nhân quả giữa các sự kiện lịch sử (Event Knowledge Graph)
model HistoricalEventRelation {
  id              String             @id @default(uuid())
  sourceEventId   String             @map("source_event_id")
  targetEventId   String             @map("target_event_id")
  relationType    EventRelationType  @default(CAUSES) @map("relation_type")
  description     String?            @db.Text
  status          VerificationStatus @default(VERIFIED)
  sourceReference String?            @map("source_reference") @db.Text
  createdAt       DateTime           @default(now()) @map("created_at")

  // Relations
  sourceEvent HistoricalEvent @relation("SourceEventRelation", fields: [sourceEventId], references: [id], onDelete: Cascade)
  targetEvent HistoricalEvent @relation("TargetEventRelation", fields: [targetEventId], references: [id], onDelete: Cascade)

  @@unique([sourceEventId, targetEventId, relationType])
  @@index([sourceEventId])
  @@index([targetEventId])
  @@index([relationType])
  @@index([status])
  @@map("historical_event_relations")
}
