// ================================
// Historical Event Model
// ================================

model HistoricalEvent {
    id            String   @id @default(uuid())
    topicId       String   @map("topic_id")
    locationId    String?  @map("location_id")
    title         String   @db.VarChar(255)
    startYear     Int?     @map("start_year")
    endYear       Int?     @map("end_year")
    eventDateNote String?  @map("event_date_note") @db.VarChar(100)
    description   String?  @db.Text
    locationNote  String?  @map("location_note") @db.VarChar(255)
    displayOrder  Int      @default(0) @map("display_order")
    createdAt     DateTime @default(now()) @map("created_at")
    updatedAt     DateTime @updatedAt @map("updated_at")

    // Relations
    topic              Topic               @relation(fields: [topicId], references: [id], onDelete: Cascade)
    historicalLocation HistoricalLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

    @@index([topicId])
    @@index([locationId])
    @@index([startYear])
    @@index([locationNote])
    @@index([displayOrder])
    @@map("historical_events")
}
