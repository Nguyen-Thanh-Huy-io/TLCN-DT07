// ================================
// Bài viết tri thức (Article) + Chuyên mục (Category)
// ================================
//
// Thay cho mô hình Knowledge Graph cũ (HistoricalEntity/Statement/Taxonomy/Period, đã xoá
// 2026-11-05). Mọi nội dung tri thức lịch sử — nhân vật, sự kiện, di tích, triều đại... — đều
// là 1 bài viết:
//   • Category  = bài này LÀ LOẠI GÌ (mỗi bài đúng 1 chuyên mục) → quyết định trang hiển thị.
//   • Tag       = bài này LIÊN QUAN CHỦ ĐỀ NÀO (nhiều-nhiều, dùng chung bảng Tag với Lesson).
//   • Timeline  = trình tự thời gian do biên tập viên tự dựng, mốc có thể trỏ tới bài viết
//                 (xem timeline.prisma).
// Không có quan hệ bài ↔ bài kiểu đồ thị: liên kết giữa các bài nằm trong nội dung (khối
// Nhân vật / Sự kiện / Bài liên quan trong contentBlocks) hoặc qua Tag chung.

model Category {
  id           String   @id @default(uuid())
  parentId     String?  @map("parent_id")
  name         String   @db.VarChar(150)
  /// Dùng làm đường dẫn công khai: /chuyen-muc/{slug}
  slug         String   @unique @db.VarChar(150)
  description  String?  @db.Text
  /// Tên icon lucide (vd. "User", "Swords", "Landmark") — chỉ để hiển thị.
  icon         String?  @db.VarChar(50)
  /// Loại bài của chuyên mục. NULL = kế thừa chuyên mục cha (gốc NULL → OTHER).
  /// Vd. "Trận đánh" (con của "Sự kiện", kind NULL) → EVENT.
  kind         ArticleKind?
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  articles Article[]

  @@index([parentId])
  @@index([displayOrder])
  @@map("categories")
}

model Article {
  id            String  @id @default(uuid())
  categoryId    String? @map("category_id")
  topicId       String? @map("topic_id")
  title         String  @db.VarChar(255)
  slug          String  @unique @db.VarChar(255)
  /// Tóm tắt 1-3 câu — hiện ở thẻ danh sách, kết quả tìm kiếm, mô tả SEO.
  summary       String? @db.Text
  coverImageUrl String? @map("cover_image_url") @db.VarChar(500)
  coverCaption  String? @map("cover_caption") @db.VarChar(255)
  /// Nội dung dạng mảng khối — cùng định dạng Lesson.content (Block Builder).
  contentBlocks Json    @default("[]") @map("content_blocks") @db.JsonB
  /// Hồ sơ mô tả TÙY CHỌN, nhập ở CMS: phần chung (aliases, sources) + nhánh theo loại bài
  /// (`person` / `site` / `event`). Chỉ để hiển thị & lọc (index GIN) — liên kết bài ↔ bài KHÔNG nằm
  /// ở đây mà ở bảng ArticleLink. Cấu trúc + chuẩn hoá: backend/src/article/article-metadata.ts.
  metadata      Json?          @db.JsonB

  /// Niên đại để hiển thị & sắp xếp. Năm âm = TCN, không có năm 0.
  /// Nhân vật: năm sinh – mất · Sự kiện: năm diễn ra · Di tích: năm xây dựng · Triều đại: tồn tại.
  dateText      String?        @map("date_text") @db.VarChar(150)
  startYear     Int?           @map("start_year")
  endYear       Int?           @map("end_year")
  datePrecision DatePrecision? @map("date_precision")

  isFeatured   Boolean       @default(false) @map("is_featured")
  displayOrder Int           @default(0) @map("display_order")
  status       ContentStatus @default(DRAFT)
  createdBy    String?       @map("created_by")
  approvedBy   String?       @map("approved_by")
  rejectionReason String?    @map("rejection_reason") @db.Text
  publishedAt  DateTime?     @map("published_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  topic         Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)
  articleTags   ArticleTag[]
  timelineNodes TimelineNode[]
  comments      ArticleComment[] @relation("ArticleCommentArticle")
  linksOut      ArticleLink[]  @relation("ArticleLinkSource")
  linksIn       ArticleLink[]  @relation("ArticleLinkTarget")

  @@index([categoryId])
  @@index([topicId])
  @@index([status])
  @@index([isFeatured])
  @@index([startYear, endYear])
  @@index([updatedAt])
  @@index([metadata], type: Gin)
  @@map("articles")
}

model ArticleTag {
  articleId String   @map("article_id")
  tagId     String   @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
  @@map("article_tags")
}

/// Liên kết bài ↔ bài (nhân vật–nhân vật, nhân vật–sự kiện, sự kiện–di tích, ...). KHÔNG có mã loại:
/// ý nghĩa suy ra từ chuyên mục 2 bài; `label` là nhãn chữ tự do tuỳ chọn ("Chỉ huy", "Phụng sự",
/// "Diễn ra tại"...). Ghi từ bài nguồn, hiển thị ở CẢ 2 bài. Xoá bài nào thì liên kết tự xoá.
model ArticleLink {
  id           String   @id @default(uuid())
  sourceId     String   @map("source_id")
  targetId     String   @map("target_id")
  label        String?  @db.VarChar(100)
  note         String?  @db.Text
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  source Article @relation("ArticleLinkSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target Article @relation("ArticleLinkTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
  @@index([targetId])
  @@map("article_links")
}

enum ArticleCommentStatus {
  VISIBLE
  REMOVED
}

model ArticleComment {
  id        String               @id @default(uuid())
  articleId  String               @map("article_id")
  authorId  String               @map("author_id")
  parentId  String?              @map("parent_id")
  content   String               @db.Text
  status    ArticleCommentStatus @default(VISIBLE)
  likeCount Int                  @default(0) @map("like_count")
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")
  deletedAt DateTime?            @map("deleted_at")

  article Article @relation("ArticleCommentArticle", fields: [articleId], references: [id], onDelete: Cascade)
  author  authUser @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  ArticleComment? @relation("ArticleCommentChildren", fields: [parentId], references: [id], onDelete: Cascade)
  replies ArticleComment[] @relation("ArticleCommentChildren")

  @@index([articleId, deletedAt])
  @@index([parentId])
  @@map("article_comments")
}
