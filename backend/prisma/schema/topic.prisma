// ================================
// Topic (Historical Topic) Model
// ================================

model Topic {
    id            String        @id @default(uuid())
    periodId      String?       @map("period_id")
    locationId    String?       @map("location_id")
    scope         TopicScope
    name          String        @db.VarChar(255)
    description   String?       @db.Text
    coverImageUrl String?       @map("cover_image_url") @db.VarChar(500)
    isSequential  Boolean       @default(false) @map("is_sequential")
    displayOrder  Int           @default(0) @map("display_order")
    status        ContentStatus @default(DRAFT)
    createdAt     DateTime      @default(now()) @map("created_at")
    updatedAt     DateTime      @updatedAt @map("updated_at")

    // Relations
    period           Period?             @relation(fields: [periodId], references: [id], onDelete: SetNull)
    location         HistoricalLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
    lessons          Lesson[]
    historicalEvents HistoricalEvent[]
    quizzes          Quiz[]

    @@index([periodId])
    @@index([locationId])
    @@index([scope])
    @@index([status])
    @@index([displayOrder])
    @@map("topics")
}
