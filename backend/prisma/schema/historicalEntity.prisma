// ================================
// Historical Entity (Master Data: Person, Organization, Dynasty, Military Force, Artifact,
// Location, Event — MỌI đối tượng lịch sử có danh tính riêng dùng chung 1 bảng này)
// ================================

model HistoricalEntity {
  id           String               @id @default(uuid())
  periodId     String?              @map("period_id")
  name         String               @db.VarChar(255)
  slug         String               @unique @db.VarChar(255)
  type         HistoricalEntityType @default(PERSON)
  tagline      String?              @db.VarChar(255)
  description  String?              @db.Text
  aliases      String[]             @default([])
  imageUrl     String?              @map("image_url") @db.VarChar(500)
  imageCaption String?              @map("image_caption") @db.VarChar(255)
  metadata     Json?                @db.JsonB

  isFeatured    Boolean        @default(false) @map("is_featured")
  displayOrder  Int            @default(0) @map("display_order")
  /// Thời gian tồn tại / diễn ra — dùng chung cho triều đại, quốc gia, tổ chức, lực lượng
  /// VÀ sự kiện (type=EVENT). Nhân vật dùng năm sinh – mất riêng ở bảng persons.
  dateText      String?        @map("date_text") @db.VarChar(150)
  startYear     Int?           @map("start_year")
  startMonth    Int?           @map("start_month")
  startDay      Int?           @map("start_day")
  endYear       Int?           @map("end_year")
  endMonth      Int?           @map("end_month")
  endDay        Int?           @map("end_day")
  datePrecision DatePrecision? @map("date_precision")
  status        ContentStatus  @default(DRAFT)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  // Relations
  period         Period?         @relation(fields: [periodId], references: [id], onDelete: SetNull)
  person         Person?
  historicalSite HistoricalSite?
  event          HistoricalEvent?

  media HistoricalEntityMedia[]

  // Knowledge Graph Statements (Subject & Object) — Event nằm trong HistoricalEntity nên
  // chỉ còn 1 cột subjectId/objectId mỗi chiều, không cần tách riêng theo loại Entity/Event.
  subjectStatements HistoricalStatement[] @relation("StatementSubject")
  objectStatements  HistoricalStatement[] @relation("StatementObject")

  @@index([type])
  @@index([periodId])
  @@index([status])
  @@index([isFeatured])
  @@index([displayOrder])
  @@index([startYear, endYear])
  @@map("historical_entities")
}

// Bảng lưu trữ tư liệu đa phương tiện (ảnh, video, tài liệu văn kiện) — dùng chung cho
// MỌI loại HistoricalEntity (nhân vật, tổ chức, di tích, sự kiện...).
model HistoricalEntityMedia {
  id           String    @id @default(uuid())
  entityId     String    @map("entity_id")
  type         MediaType @default(IMAGE)
  url          String    @db.VarChar(500)
  caption      String?   @db.VarChar(255)
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")

  // Relations
  entity HistoricalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId])
  @@index([displayOrder])
  @@map("historical_entity_media")
}
