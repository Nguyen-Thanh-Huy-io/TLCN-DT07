DATABASE_URL=postgresql://admin:admin@127.0.0.1:5433/tlcn_db

POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=tlcn_db

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

DATABASE_PORT=5433
DATABASE_HOST=127.0.0.1

NODE_ENV=development

PORT=5000
APP_URL=http://localhost:5000

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

JWT_SECRET=super-secret-jwt-key-for-tlcn-project-2026

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@yourapp.com

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Google Cloud Vertex AI Configuration (Moderation, Assistant, Flashcards AI, Mindmap AI)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=us-central1
# Đường dẫn tới file service-account.json HOẶC dán trực tiếp JSON / base64 JSON vào GOOGLE_CLOUD_SERVICE_ACCOUNT_JSON
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_SERVICE_ACCOUNT_JSON=
GOOGLE_CLOUD_AI_MODEL=gemini-2.0-flash

# Vertex AI RAG Engine (Chatbox Sử Gia AI — phải dùng regional location như us-central1, không dùng global)
GOOGLE_CLOUD_RAG_LOCATION=us-central1
GOOGLE_CLOUD_RAG_BUCKET=
GOOGLE_CLOUD_RAG_CORPUS=
GOOGLE_CLOUD_RAG_TOP_K=6
GOOGLE_CLOUD_RAG_DISTANCE_THRESHOLD=0.62

# (Tùy chọn fallback) Gemini API Key nếu không dùng Service Account Vertex AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Staff seed (prisma/seed-staff.ts) — dev/test only
SEED_SUPERADMIN_EMAIL=admin@hisgo.edu.vn
SEED_STAFF_PASSWORD=change-me-Staff2026

# Test e2e (npm run test:e2e:prepare && npm run test:e2e) — mặc định dùng DB dev + hậu tố _e2e và Redis DB 1
# E2E_DATABASE_URL=postgresql://admin:admin@127.0.0.1:5433/tlcn_db_e2e
# E2E_REDIS_DB=1
