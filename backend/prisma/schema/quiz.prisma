// ================================
// Quiz (Đề ôn tập cuối bài học) Model
// ================================

// 1 Lesson có tối đa 1 Quiz. Danh sách câu hỏi lưu dạng mảng JSONB trong `questions`,
// giống cách `Lesson.content` lưu mảng khối nội dung — không tách bảng con riêng vì
// không có nhu cầu truy vấn SQL lọc theo từng câu hỏi lẻ, chỉ luôn đọc/viết nguyên mảng.
//
// Mỗi phần tử trong `questions` tự khai báo field `type` (validate ở DTO backend, không
// phải cột DB — theo đúng cách `LessonBlockType` của Lesson.content đang làm) với 1 trong
// 5 giá trị: MULTIPLE_CHOICE | TRUE_FALSE | ORDERING | MATCHING | FILL_IN_BLANK, kèm phần
// dữ liệu riêng theo từng loại (options[] / correctAnswer / items+correctOrder /
// leftItems+rightItems+correctPairs / acceptedAnswers[]).
model Quiz {
  id                  String  @id @default(uuid())
  lessonId            String? @unique @map("lesson_id")
  title               String? @db.VarChar(255)
  description         String? @db.Text
  passingScorePercent Int?    @map("passing_score_percent")
  timeLimitMinutes    Int?    @default(15) @map("time_limit_minutes")
  questions           Json    @default("[]") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lesson   Lesson?       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  topics   Topic[]       @relation("TopicQuizzes")
  attempts QuizAttempt[]

  @@map("quizzes")
}

// ================================
// QuizAttempt (Lịch sử nộp bài & thống kê) Model
// ================================

model QuizAttempt {
  id               String   @id @default(uuid())
  quizId           String   @map("quiz_id")
  userId           String?  @map("user_id")
  learnerName      String?  @map("learner_name") @db.VarChar(150)
  scorePercent     Int      @map("score_percent")
  correctCount     Int      @map("correct_count")
  totalQuestions   Int      @map("total_questions")
  timeSpentSeconds Int      @default(0) @map("time_spent_seconds")
  isPassed         Boolean  @default(false) @map("is_passed")
  answers          Json     @default("[]") @db.JsonB
  createdAt        DateTime @default(now()) @map("created_at")

  quiz             Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user             authUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([quizId])
  @@index([userId])
  @@index([createdAt])
  @@map("quiz_attempts")
}

// ================================
// Question (Ngân hàng câu hỏi tập trung) Model
// ================================

model Question {
  id          String          @id @default(uuid())
  type        String          @db.VarChar(50) // SINGLE_CHOICE, TRUE_FALSE, MULTIPLE_CHOICE, ORDERING, MATCHING, FILL_IN_BLANK
  prompt      String          @db.Text
  explanation String?         @db.Text
  difficulty  DifficultyLevel @default(MEDIUM)
  points      Int             @default(10)
  data        Json            @default("{}") @db.JsonB

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  lessons     Lesson[]
  topics      Topic[]

  @@index([type])
  @@index([difficulty])
  @@map("questions")
}
