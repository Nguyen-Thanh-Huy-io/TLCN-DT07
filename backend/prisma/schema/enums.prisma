// ================================
// User & Auth Related Enums
// ================================

enum UserRole {
  USER
  ADMIN
  MODERATOR
  SUPERADMIN

  @@map("userRole")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
  BLOCKED

  @@map("userStatus")
}

enum MfaMethod {
  totp
  sms
  email
  webauthn

  @@map("mfaMethod")
}

enum LoginAction {
  login
  logout

  @@map("loginAction")
}

// ================================
// Email Related Enums
// ================================

enum EmailType {
  verification
  password_reset
  notification

  @@map("email_type")
}

enum EmailProvider {
  sendgrid
  mailgun
  ses
  smtp

  @@map("email_provider")
}

enum EmailStatus {
  sent
  failed
  pending
  bounced
  delivered
  opened
  clicked

  @@map("email_status")
}

// ================================
// Content & Learning Related Enums
// ================================

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum LearningPathType {
  CHRONOLOGICAL
  THEMATIC
}

// Biểu tượng hiển thị cho chủ đề kiến thức trên landing page
enum TopicIcon {
  Landmark
  Castle
  Swords
  Scale
  BookOpen
  MapPin
}

// Độ chính xác niên đại dùng chung cho toàn bộ dữ liệu lịch sử
enum DatePrecision {
  DAY
  MONTH
  YEAR
  DECADE
  CENTURY
  APPROXIMATE
  RANGE
  UNKNOWN
}

// Loại bài viết — gắn trên Category (bài lấy loại theo chuyên mục của nó). Quyết định nhánh hồ sơ
// (metadata.person/site/event) và cách giao diện công khai hiển thị bài (nhân vật, sự kiện, di tích...).
enum ArticleKind {
  PERSON
  EVENT
  LOCATION
  DYNASTY
  OTHER
}

// ================================
// Community & Moderation Enums
// ================================

enum PostType {
  QUICK_POST
  LONG_FORM
}

enum ReportRiskLevel {
  SAFE
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReportActionTaken {
  NONE
  AUTO_HIDDEN
  CONFIRMED_REMOVED
  DISMISSED
}

enum ReportSource {
  USER_REPORT
  AI_SCAN
}

enum ReportTargetType {
  POST
  COMMENT
}

enum PostCommentStatus {
  VISIBLE
  REMOVED
}
