// ================================
// Lesson (Historical Reading Lesson) Model
// ================================

enum LessonStatus {
  DRAFT
  REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

model Lesson {
  id          String  @id @default(uuid())
  title       String  @db.VarChar(255)
  slug        String  @unique @db.VarChar(255)
  description String? @db.Text

  // Cấu trúc nội dung bài học
  content             Json            @default("[]") @db.JsonB
  contentRichText     String?         @map("content_rich_text") @db.Text
  thumbnailUrl        String?         @map("thumbnail_url") @db.VarChar(500)
  difficulty          DifficultyLevel @default(MEDIUM)
  sourceReferenceNote String?         @map("source_reference_note") @db.Text

  status LessonStatus @default(DRAFT)

  // Liên kết nhiều-nhiều với Nhãn phân loại (Tag) qua bảng trung gian LessonTag
  lessonTags LessonTag[]

  // Liên kết nhiều-nhiều với Chương trong các Lộ trình học (Learning Path & Chapter Pool)
  chapterLessons ChapterLesson[]

  // Đề ôn tập cuối bài (1 bài học có tối đa 1 đề) — xem model Quiz trong quiz.prisma
  quiz Quiz?

  displayOrder Int @default(0) @map("display_order")

  createdBy       String?   @map("created_by")
  approvedBy      String?   @map("approved_by")
  publishedAt     DateTime? @map("published_at")
  rejectionReason String?   @map("rejection_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([displayOrder])
  @@index([updatedAt])
  @@map("lessons")
}
