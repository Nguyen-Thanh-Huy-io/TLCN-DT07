// ================================
// Lesson (Historical Lesson) Model
// ================================

enum MediaType {
    IMAGE
    VIDEO
    DOCUMENT
}

model Lesson {
    id                  String          @id @default(uuid())
    topicId             String          @map("topic_id")
    title               String          @db.VarChar(255)
    contentRichText     String?         @map("content_rich_text") @db.Text
    thumbnailUrl        String?         @map("thumbnail_url") @db.VarChar(500)
    difficulty          DifficultyLevel @default(MEDIUM)
    sourceReferenceNote String?         @map("source_reference_note") @db.Text
    displayOrder        Int             @default(0) @map("display_order")
    status              ContentStatus   @default(DRAFT)
    rejectionReason     String?         @map("rejection_reason") @db.Text
    publishedAt         DateTime?       @map("published_at")
    createdBy           String          @map("created_by")
    approvedBy          String?         @map("approved_by")
    createdAt           DateTime        @default(now()) @map("created_at")
    updatedAt           DateTime        @updatedAt @map("updated_at")

    // Relations
    topic      Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
    creator    authUser      @relation("LessonCreator", fields: [createdBy], references: [id])
    approver   authUser?     @relation("LessonApprover", fields: [approvedBy], references: [id])
    lessonTags LessonTag[]
    media      LessonMedia[]

    @@index([topicId])
    @@index([status])
    @@index([difficulty])
    @@index([displayOrder])
    @@map("lessons")
}

// ================================
// LessonMedia (Images/Videos) Model
// ================================

model LessonMedia {
    id           String    @id @default(uuid())
    lessonId     String    @map("lesson_id")
    type         MediaType @default(IMAGE)
    url          String    @db.VarChar(500)
    caption      String?   @db.VarChar(255)
    displayOrder Int       @default(0) @map("display_order")
    createdAt    DateTime  @default(now()) @map("created_at")

    // Relations
    lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

    @@index([lessonId])
    @@map("lesson_media")
}
