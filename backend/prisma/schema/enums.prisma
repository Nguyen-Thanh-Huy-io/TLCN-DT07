}

// Phân loại sự kiện lịch sử (Dựa trên đối chiếu mẫu dữ liệu thực tế)
enum EventCategory {
  BATTLE // Trận đánh / Chiến dịch / Hải chiến
  WAR // Chiến tranh / Xung đột vũ trang / Nội chiến
  TREATY // Hiệp ước / Hòa ước / Tuyên bố hòa bình
  REVOLUTION // Cách mạng / Khởi nghĩa / Phong trào
  POLITICAL_EVENT // Đảo chính / Biến cố chính trị
  SUMMIT_CONFERENCE // Hội nghị / Thượng đỉnh quốc tế
  CULTURE_SCIENCE // Văn hóa / Khám phá khoa học / Du hành vũ trụ
  NATURAL_DISASTER // Thiên tai / Động đất / Đại dịch
  OTHER // Khác
}

// Loại quan hệ nhân quả và mạng lưới giữa các sự kiện lịch sử (Event Knowledge Graph)
enum EventRelationType {
  CAUSES // Nguyên nhân trực tiếp / Gây ra
  PRECEDES // Tiền đề / Diễn ra trước
  FOLLOWS // Tiếp nối / Hệ quả
  INFLUENCES // Tác động / Ảnh hưởng
  PARALLEL_TO // Diễn ra đồng thời / Song song
  OPPOSES // Đối kháng / Phản ứng lại
  DERIVED_FROM // Bắt nguồn từ
  OTHER // Mối liên hệ khác
}

// Trạng thái xác minh học thuật của mối liên hệ sự kiện
enum VerificationStatus {
  VERIFIED // Đã xác minh (Đồng thuận chính sử)
  HYPOTHESIS // Giả thuyết lịch sử
  DISPUTED // Còn tranh cãi học thuật
  DRAFT // Bản nháp đang nghiên cứu
}

// Độ chính xác niên đại cho Thời kỳ lịch sử
