// ================================
// Person (Nhân vật lịch sử - 1-1 với HistoricalEntity)
// ================================

model Person {
  entityId       String         @id @map("entity_id")
  birthDateText  String?        @map("birth_date_text") @db.VarChar(100)
  birthYear      Int?           @map("birth_year")
  birthMonth     Int?           @map("birth_month")
  birthDay       Int?           @map("birth_day")
  birthPrecision DatePrecision? @map("birth_precision")
  deathDateText  String?        @map("death_date_text") @db.VarChar(100)
  deathYear      Int?           @map("death_year")
  deathMonth     Int?           @map("death_month")
  deathDay       Int?           @map("death_day")
  deathPrecision DatePrecision? @map("death_precision")

  // Cột tương thích ngược giữ song song với birthDateText / deathDateText
  birthDateLabel String?        @map("birth_date_label") @db.VarChar(100)
  deathDateLabel String?        @map("death_date_label") @db.VarChar(100)

  biography      String?        @db.Text
  occupation     String?        @db.VarChar(255)
  titles         String[]       @default([])
  /// Mã vai trò nhân vật (nhóm FIGURE_ROLE trong danh mục dùng chung) — thêm vai trò mới từ CMS.
  roles          String[]       @default([])
  /// Id tương ứng của roles, trigger tự đồng bộ.
  roleIds        String[]       @default([]) @map("role_ids")

  entity HistoricalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([birthYear, deathYear])
  @@index([roleIds], type: Gin)
  @@map("persons")
}
