{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/page.tsx!",
    "src/app/**/layout.tsx!"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignoreDependencies": [
    "tailwindcss",
    "clsx",
    "tailwind-merge"
  ],
  "ignore": [
    "src/constants/enums.ts",
    "src/features/mindmap/**",
    "src/features/lessons/components/properties/**"
  ],
  "ignoreExportsUsedInFile": true
}
