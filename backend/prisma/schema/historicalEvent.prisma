// ================================
// Historical Event Model (Master Data dùng chung + Mạng lưới liên kết Knowledge Graph)
// ================================

model HistoricalEvent {
  id            String        @id @default(uuid())
  periodId      String?       @map("period_id")
  locationId    String?       @map("location_id")
  parentId      String?       @map("parent_id")
  title         String         @db.VarChar(255)
  slug          String         @unique @db.VarChar(255)
  dateText      String?        @map("date_text") @db.VarChar(150)
  startYear     Int?           @map("start_year")
  startMonth    Int?           @map("start_month")
  startDay      Int?           @map("start_day")
  endYear       Int?           @map("end_year")
  endMonth      Int?           @map("end_month")
  endDay        Int?           @map("end_day")
  datePrecision DatePrecision? @map("date_precision")
  eventDateNote String?        @map("event_date_note") @db.VarChar(150)
  summary       String?       @db.Text
  description   String?       @db.Text
  thumbnailUrl  String?       @map("thumbnail_url") @db.VarChar(500)
  displayOrder  Int           @default(0) @map("display_order")
  category      EventCategory @default(OTHER)
  /// Loại sự kiện theo danh mục dùng chung (nhóm EVENT_CATEGORY), phần tử đầu là loại chính.
  /// Cột category (enum) giữ song song, luôn đồng bộ theo loại chính, cho dữ liệu nhập cũ.
  categoryIds   String[]      @default([]) @map("category_ids")
  metadata      Json?         @db.JsonB
  status        ContentStatus @default(PUBLISHED)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  period   Period?                 @relation(fields: [periodId], references: [id], onDelete: SetNull)
  location HistoricalEntity?       @relation("EventPrimaryLocation", fields: [locationId], references: [id], onDelete: SetNull)
  parent   HistoricalEvent?        @relation("HistoricalEventHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children HistoricalEvent[]       @relation("HistoricalEventHierarchy")
  media    HistoricalEventMedia[]

  // Knowledge Graph Statements (Subject & Object)
  subjectStatements HistoricalStatement[]   @relation("StatementSubjectEvent")
  objectStatements  HistoricalStatement[]   @relation("StatementObjectEvent")
  eventPeriods      HistoricalEventPeriod[]

  // Thực thể / Nhân vật tham gia sự kiện (Historical Event Participants)
  participants      HistoricalEventParticipant[]

  @@index([periodId])
  @@index([locationId])
  @@index([parentId])
  @@index([startYear, startMonth, startDay])
  @@index([category])
  @@index([categoryIds], type: Gin)
  @@index([displayOrder])
  @@index([status])
  @@map("historical_events")
}

// Bảng lưu trữ đa phương tiện (ảnh, video, tài liệu) cho Sự kiện Lịch sử
model HistoricalEventMedia {
  id           String    @id @default(uuid())
  eventId      String    @map("event_id")
  type         MediaType @default(IMAGE)
  url          String    @db.VarChar(500)
  caption      String?   @db.VarChar(255)
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")

  // Relations
  event HistoricalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([displayOrder])
  @@map("historical_event_media")
}

// ================================
// Thực thể / Nhân vật tham gia Sự kiện Lịch sử (Historical Event Participants)
// ================================
model HistoricalEventParticipant {
  id                String   @id @default(uuid())
  eventId           String   @map("event_id")
  entityId          String   @map("entity_id")
  roleTermId        String?  @map("role_term_id")
  roleLabelOverride String?  @map("role_label_override") @db.VarChar(150)
  isPrimary         Boolean  @default(false) @map("is_primary")
  displayOrder      Int      @default(0) @map("display_order")
  startYear         Int?     @map("start_year")
  endYear           Int?     @map("end_year")
  notes             String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  event      HistoricalEvent                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  entity     HistoricalEntity                      @relation(fields: [entityId], references: [id], onDelete: Cascade)
  roleTerm   TaxonomyTerm?                         @relation("EventParticipantRoleTerm", fields: [roleTermId], references: [id], onDelete: SetNull)
  references HistoricalEventParticipantReference[]

  @@index([eventId, entityId])
  @@index([roleTermId])
  @@index([isPrimary])
  @@index([startYear, endYear])
  @@map("historical_event_participants")
}
