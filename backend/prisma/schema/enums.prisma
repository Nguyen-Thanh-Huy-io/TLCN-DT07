// ================================
// User & Auth Related Enums
// ================================

enum UserRole {
  USER
  ADMIN
  MODERATOR
  SUPERADMIN

  @@map("userRole")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
  BLOCKED

  @@map("userStatus")
}

enum MfaMethod {
  totp
  sms
  email
  webauthn

  @@map("mfaMethod")
}

enum LoginAction {
  login
  logout

  @@map("loginAction")
}

// ================================
// Email Related Enums
// ================================

enum EmailType {
  verification
  password_reset
  notification

  @@map("email_type")
}

enum EmailProvider {
  sendgrid
  mailgun
  ses
  smtp

  @@map("email_provider")
}

enum EmailStatus {
  sent
  failed
  pending
  bounced
  delivered
  opened
  clicked

  @@map("email_status")
}

