// ================================
// Auth User Model
// ================================

model authUser {
  id           String     @id @default(uuid())
  email        String     @unique
  password     String
  username     String     @unique
  role         UserRole   @default(USER)
  verified     Boolean    @default(false)
  status       UserStatus @default(ACTIVE)
  tokenVersion Int        @default(1) // For immediate JWT revocation on security events
  deletedAt    DateTime?
  provider     String     @default("local")
  providerId   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  userProfile       userProfile?
  authSecurity      authSecurity?
  loginHistory      loginHistory[]
  emailHistory      emailHistory[]
  pathEnrollments   LearningPathEnrollment[]
  lessonProgress    LessonProgress[]
  discussionThreads DiscussionThread[]
  discussionReplies DiscussionReply[]
  notifications     Notification[]
  quizAttempts      QuizAttempt[]
  notes             Note[]
  blogPosts         BlogPost[]
  blogPostComments  BlogPostComment[]        @relation("BlogPostCommentAuthor")
  postLikes         PostLike[]               @relation("PostLikeUser")
  postBookmarks     PostBookmark[]           @relation("PostBookmarkUser")
  postCommentLikes  PostCommentLike[]        @relation("PostCommentLikeUser")
  reportsMade       ContentReport[]          @relation("ContentReportReporter")
  reportReviews     ContentReport[]          @relation("ContentReportReviewer")
  following         UserFollow[]             @relation("UserFollowFollower")
  followers         UserFollow[]             @relation("UserFollowFollowing")

  @@index([email, id, providerId])
  @@index([username])
}

// ================================
// Auth Security Model
// ================================

model authSecurity {
  id                 String     @id @default(uuid())
  authId             String     @unique
  failedAttempts     Int        @default(0)
  lastFailedAt       DateTime?
  lockExpiresAt      DateTime?
  mfaEnabled         Boolean    @default(false)
  mfaMethod          MfaMethod?
  mfaSecret          String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  lastPasswordChange DateTime?

  // Relations
  authUser authUser @relation(fields: [authId], references: [id], onDelete: Cascade)

  @@index([authId])
}
