// ================================
// Historical Entity (Master Data: Person, Organization, Dynasty, Military Force, Artifact)
// ================================

model HistoricalEntity {
  id           String               @id @default(uuid())
  periodId     String?              @map("period_id")
  name         String               @db.VarChar(255)
  slug         String               @unique @db.VarChar(255)
  type         HistoricalEntityType @default(PERSON)
  tagline      String?              @db.VarChar(255)
  description  String?              @db.Text
  aliases      String[]             @default([])
  imageUrl     String?              @map("image_url") @db.VarChar(500)
  imageCaption String?              @map("image_caption") @db.VarChar(255)
  metadata     Json?                @db.JsonB

  isFeatured    Boolean        @default(false) @map("is_featured")
  displayOrder  Int            @default(0) @map("display_order")
  /// Thời gian tồn tại của triều đại / quốc gia / chính thể, tổ chức, lực lượng (nhân vật dùng
  /// năm sinh – mất ở bảng persons).
  dateText      String?        @map("date_text") @db.VarChar(150)
  startYear     Int?           @map("start_year")
  endYear       Int?           @map("end_year")
  datePrecision DatePrecision? @map("date_precision")
  status        ContentStatus  @default(DRAFT)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  // Relations
  period         Period?         @relation(fields: [periodId], references: [id], onDelete: SetNull)
  person         Person?
  historicalSite HistoricalSite?

  eventParticipations HistoricalEventParticipant[]
  media               HistoricalEntityMedia[]

  // Các sự kiện mà thực thể này là địa điểm diễn ra chính
  primaryEvents HistoricalEvent[] @relation("EventPrimaryLocation")

  // Knowledge Graph Statements (Subject & Object)
  subjectStatements HistoricalStatement[] @relation("StatementSubjectEntity")
  objectStatements  HistoricalStatement[] @relation("StatementObjectEntity")

  @@index([type])
  @@index([periodId])
  @@index([status])
  @@index([isFeatured])
  @@index([displayOrder])
  @@index([startYear, endYear])
  @@map("historical_entities")
}

// Bảng lưu trữ tư liệu đa phương tiện (ảnh, video, tài liệu văn kiện) cho Thực thể Lịch sử
model HistoricalEntityMedia {
  id           String    @id @default(uuid())
  entityId     String    @map("entity_id")
  type         MediaType @default(IMAGE)
  url          String    @db.VarChar(500)
  caption      String?   @db.VarChar(255)
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")

  // Relations
  entity HistoricalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId])
  @@index([displayOrder])
  @@map("historical_entity_media")
}
